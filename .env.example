# Required for Gemini answer generation
GOOGLE_API_KEY=

# Local llama.cpp embedding server
EMBEDDING_SERVER_URL=http://127.0.0.1:8081
EMBEDDING_REQUEST_TIMEOUT=120

# Optional project paths. Relative values are resolved from the repository root.
KNOWLEDGE_BASE_DIR=knowledge-base
DOCUMENT_CACHE_PATH=document-cache/extracted_documents.jsonl
PROOF_OF_OCR_DIR=proof_of_ocr
DB_NAME=vector_stores/page_level_semantic
QUESTION_SET=rag_evals/questions/test_page_level_semantic_percentile_95.jsonl

# Reranker: auto selects CUDA, Apple MPS, or CPU.
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=auto
# Use 0 for an automatic batch size.
RERANKER_BATCH_SIZE=0

# Optional Hugging Face cache location.
# Leave unset to use the platform default.
# HF_HOME=
